<!-- Easygram music widget, COMPACT variant (2 rows): cover + texts + controls, wave below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_music_cover"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/EasygramWidgetCover"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/widget_music_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_music_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_music_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_music_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_music_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_music_button_bg"
            android:contentDescription="@string/AccDescrPrevious"
            android:padding="8dp"
            android:src="@drawable/widget_music_ic_prev" />

        <FrameLayout
            android:id="@+id/widget_music_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/AccActionPlay">

            <ImageView
                android:id="@+id/widget_music_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_music_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_music_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_music_button_bg"
            android:contentDescription="@string/Next"
            android:padding="8dp"
            android:src="@drawable/widget_music_ic_next" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_music_wave_container"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/widget_music_wave_rest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_music_wave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <include layout="@layout/widget_music_seek_zones" />
    </FrameLayout>
</LinearLayout>
