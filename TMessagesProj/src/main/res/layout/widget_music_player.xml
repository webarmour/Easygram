<?xml version="1.0" encoding="utf-8"?>
<!-- Easygram music widget, TALL variant: big centred cover. Wave and play button are pre-rendered alpha masks
     tinted by the ImageViews (see MusicWidgetUpdater). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_music_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/EasygramWidgetCover"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/widget_music_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_music_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_music_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_music_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_music_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_music_wave_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/widget_music_wave_rest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_music_wave"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <include layout="@layout/widget_music_seek_zones" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_music_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_music_button_bg"
            android:contentDescription="@string/AccDescrPrevious"
            android:padding="12dp"
            android:src="@drawable/widget_music_ic_prev" />

        <FrameLayout
            android:id="@+id/widget_music_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/AccActionPlay">

            <ImageView
                android:id="@+id/widget_music_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/widget_music_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_music_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_music_button_bg"
            android:contentDescription="@string/Next"
            android:padding="12dp"
            android:src="@drawable/widget_music_ic_next" />
    </LinearLayout>
</LinearLayout>
