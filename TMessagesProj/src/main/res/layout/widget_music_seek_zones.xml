<?xml version="1.0" encoding="utf-8"?>
<!-- 24 static tap zones over the widget's wave: RemoteViews can't report tap coordinates, and zones added at
     runtime (addView) get re-created by the launcher on every frame, which swallows taps during playback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_seek"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/widget_music_seek_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:importantForAccessibility="no" />
